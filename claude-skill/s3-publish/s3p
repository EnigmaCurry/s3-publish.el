#!/usr/bin/env bash
# s3p — publish files with s3-publish.el, in a fresh `emacs --batch'.
#
# The user's running Emacs is never involved: each command starts its own
# Emacs with none of their configuration, reading only their s3-publish
# settings (profiles etc.) from their custom file.  Prints JSON on stdout.
set -euo pipefail

usage() {
    cat <<'EOF'
usage: s3p COMMAND [ARGS]

  check                                   Settings, library and s3cmd found?
  profiles                                List profiles (name, bucket, public, feed, last-used)
  publish FILE PROFILE [--title T] [--name N] [--run-code]
                                          Publish FILE; Org/Markdown -> HTML page + source.
                                          --name publishes under N (N.html for a document)
                                          instead of a hashed key.
                                          --run-code tangles and evaluates Org code blocks.
  list PROFILE [--bucket]                 Published files (feed), or every object in the bucket
  delete TARGET PROFILE                   Delete a URL, s3:// URI or file path (all its keys)
  sign TARGET DURATION PROFILE            Signed URL valid for DURATION (e.g. 1h, 7d)

Environment:
  S3P_SETTINGS_FILE  File holding (custom-set-variables '(s3-publish-profiles ...))
                     (default: the first of ~/.emacs.d/custom.el,
                     ~/.config/emacs/custom.el, ~/.emacs.d/init.el, ~/.emacs that
                     mentions s3-publish-profiles)
  S3P_HISTORY_FILE   savehist file, for last-used (default ~/.emacs.d/history)
  S3P_LOAD_PATH      Extra load-path directories, colon separated (htmlize is
                     looked for under ~/.emacs.d/straight and ~/.emacs.d/elpa)
EOF
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
case "$1" in -h|--help|help) usage; exit 0 ;; esac

here=$(dirname "$(readlink -f "$0")")
library_dir=$(readlink -f "$here/../..")
[ -f "$library_dir/s3-publish.el" ] || {
    echo "s3p: s3-publish.el not found in $library_dir" >&2; exit 2; }

if [ -z "${S3P_SETTINGS_FILE:-}" ]; then
    for f in ~/.emacs.d/custom.el ~/.config/emacs/custom.el ~/.emacs.d/init.el ~/.emacs; do
        if [ -f "$f" ] && grep -q "s3-publish-profiles" "$f"; then
            S3P_SETTINGS_FILE=$f; break
        fi
    done
fi
export S3P_SETTINGS_FILE=${S3P_SETTINGS_FILE:-}
export S3P_HISTORY_FILE=${S3P_HISTORY_FILE:-$HOME/.emacs.d/history}

load_path=(-L "$library_dir")
IFS=: read -r -a extra <<< "${S3P_LOAD_PATH:-}"
for d in "${extra[@]}" \
         ~/.emacs.d/straight/build/htmlize \
         $(ls -d ~/.emacs.d/elpa/htmlize-* 2>/dev/null | tail -1); do
    [ -n "$d" ] && [ -d "$d" ] && load_path+=(-L "$d")
done

# A path is made absolute here, where the caller's directory is known.
args=("$@")
if [ "${args[0]}" = publish ] && [ ${#args[@]} -ge 2 ]; then
    args[1]=$(realpath -e -- "${args[1]}")
fi
if [[ ${args[0]} =~ ^(delete|sign)$ ]] && [ ${#args[@]} -ge 2 ] \
       && [[ ! ${args[1]} =~ ^[a-zA-Z][a-zA-Z0-9+.-]*:// ]] && [[ ${args[1]} != /* ]] \
       && [ -e "${args[1]}" ]; then
    args[1]=$(realpath -- "${args[1]}")
fi

# Progress messages go to a log; on failure, its tail goes to stderr.
log=$(mktemp -t s3p-log.XXXXXX)
trap 'rm -f "$log"' EXIT
status=0
# Emacs reads options such as --name and --title wherever they appear on
# its command line, so every argument is passed with a prefix that no
# option has, which s3p-main strips.
emacs --batch -Q "${load_path[@]}" -l "$here/s3p.el" -f s3p-main "${args[@]/#/s3p:}" \
      2>"$log" </dev/null || status=$?
if [ $status -ne 0 ]; then
    tail -20 "$log" >&2
fi
exit $status
